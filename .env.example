# Conexão com o PostgreSQL (usuário da aplicação, sem superpoderes)
# Formato: postgres://USUARIO:SENHA@HOST:PORTA/BANCO
DATABASE_URL=postgres://invictus_app:troque-esta-senha@localhost:5432/invictus
# Ative apenas se o Postgres estiver em outro host/servidor (VPS)
# DATABASE_SSL=true
DB_POOL_MAX=10

# Porta da API (Fastify)
PORT=3333
# Segredo para assinar cookies de sessão (gere: openssl rand -hex 32)
COOKIE_SECRET=troque-por-uma-string-aleatoria-longa
# Origens permitidas no CORS (separadas por vírgula)
CORS_ORIGIN=http://localhost:5173
# Diretório das fotos enviadas (padrão: server/uploads)
# UPLOADS_DIR=/var/www/invictus/uploads